{
  "name": "portfolio",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // assets normally win before the Worker runs; this lets the Worker
    // see requests to "/" so it can answer curl with the ascii version
    "run_worker_first": ["/", "/index.html"]
  }
}
